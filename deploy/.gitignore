# =============================================================================
# Sub2API Deploy Directory - Git Ignore
# =============================================================================

# Data directories (generated at runtime when using docker-compose.local.yml)
# 用 data/* 而非 data/：允许对仓库维护的价表文件做 re-include
data/*
# 仓库维护的合并模型数据文档（目录 + 价表，非运行时产物，须入库）
!data/models.json
!data/models.json.sha256
postgres_data/
redis_data/

# Environment configuration (contains sensitive information)
.env

# Backup files
*.backup
*.bak

# Temporary files
*.tmp
*.log
